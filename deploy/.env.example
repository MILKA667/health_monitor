# Скопируйте в .env на сервере рядом с docker-compose.yml

# Образы в GitHub Container Registry (имя репозитория — строчными буквами)
IMAGE_PREFIX=ghcr.io/milka667/health_monitor

DB_NAME=health_monitor
DB_USER=healthmonitor
# Сгенерировать: openssl rand -hex 24
DB_PASSWORD=
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Порт nginx на хосте; при HTTPS через внешний прокси — например 8080
WEB_PORT=80
# 1, если сайт открывается по HTTPS
SESSION_COOKIE_SECURE=0
